{
  // ── API tsconfig — covers api/ (Vercel serverless, Node environment) ──
  // This is a STANDALONE config — it is NOT referenced from the root tsconfig.json
  // because Vercel compiles the api/ folder separately from your Vite frontend.
  // VS Code picks this up automatically for files inside api/.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "CommonJS",       // Vercel Node functions use CommonJS
    "moduleResolution": "node",

    /* Node types — fixes process, Buffer, IncomingMessage, etc. */
    "types": ["node"],

    /* Strict mode */
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["../src", "../node_modules"]
}